  "code": {
    "at": [
      3.6,
      -1.6
    ],
    "fontSize": 0.24,
    "lines": [
      "push(x) {",
      "  if (this.len === CAP) throw new Full();",
      "  this.buf[this.tail] = x;",
      "  this.tail = (this.tail + 1) % CAP;",
      "  this.len++;",
      "}",
      "pop() {",
      "  const x = this.buf[this.head];",
      "  this.head = (this.head + 1) % CAP;",
      "  this.len--; return x;",
      "}"
    ]
  },
